programa
{
	
	inclua biblioteca Matematica
	funcao inicio()
	{
		real x1,x2,y1,y2
		real d

		escreva("Valor de x1: ")
		leia(x1)
		escreva("Valor de x2: ")
		leia(x2)
		escreva("Valor de y1: ")
		leia(y1)
		escreva("Valor de y2: ")
		leia(y2)

		d= Matematica.raiz(radicando, 2.0)
	}
}
